{
  "schema": "comotion.parameter_sweep.v1",
  "description": "Small planner parameter sweep for the 4-Panda heterogeneous corridor. Also includes Panda cage and flying-sphere app presets with the requested robot counts and timeouts.",
  "defaults": {
    "collision_backend": "vamp",
    "resolution": 128,
    "trials_per_param_set": 1,
    "methods": [
      "composite",
      "prioritized",
      "drrt",
      "stcbs",
      "arc"
    ]
  },
  "apps": {
    "heterogenous_p4_s8": {
      "title": "Heterogeneous corridor, 4 Pandas + 8 flying spheres",
      "executable": "heterogeneous_corridor",
      "args": [
        "--num-pandas",
        "4",
        "--num-spheres",
        "8",
        "--task-index",
        "0"
      ],
      "time_limit": 1000.0,
      "base_params": {
        "strrt_initial_batch_size": 4096,
        "strrt_initial_time_factor": 4.0,
        "strrt_time_bound_factor_increase": 2.0,
        "strrt_return_first_solution": true,
        "strrt_rewiring": "off",
        "drrt_roadmap_size": 200,
        "drrt_iterations_per_batch": 8,
        "drrt_cost_metric": "sum_of_costs",
        "drrt_tensor_search": "drrt",
        "composite_rrt_simplify_solution": false,
        "composite_rrt_use_makespan_metric": false,
        "composite_aorrtc_max_internal_samples": 10000,
        "composite_aorrtc_max_internal_vertices": 10000,
        "cooperative_rrt_worker_threads": 2,
        "arc_initial_window": 200,
        "arc_expansion_step": 200,
        "arc_local_composite_max_samples": 500000,
        "arc_local_composite_use_makespan_metric": false,
        "arc_simplify_initial_solutions": true,
        "arc_simplify_conflict_solutions": false,
        "arc_local_solvers": "composite",
        "arc_local_prioritized_max_iterations": 5,
        "ao_arc_local_bound_epsilon_timesteps": 1,
        "or_parallel_worker_processes": 1,
        "parallel_arc_worker_processes": 2,
        "parallel_arc_parallel_initial_plans": true,
        "parallel_arc_initial_solution_or": false,
        "parallel_arc_repair_duplicate_attempts": true,
        "parallel_arc_strategy": "synchronous",
        "parallel_arc_conflict_strategy": "greedy",
        "parallel_arc_conflict_find_mode": "segment_parallel",
        "parallel_arc_conflict_find_horizon": 400,
        "stcbs_max_ct_nodes": 5000,
        "stcbs_max_samples": 75000
      },
      "param_grid": {
        "composite": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "makespan_metric",
            "params": {
              "composite_rrt_use_makespan_metric": true
            }
          }
        ],
        "prioritized": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "smaller_initial_batch",
            "params": {
              "strrt_initial_batch_size": 2048,
              "strrt_initial_time_factor": 2.0
            }
          }
        ],
        "drrt": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "smaller_roadmap",
            "params": {
              "drrt_roadmap_size": 100,
              "drrt_iterations_per_batch": 4
            }
          }
        ],
        "stcbs": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "lower_sample_cap",
            "params": {
              "stcbs_max_samples": 25000
            }
          }
        ],
        "arc": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "smaller_windows",
            "params": {
              "arc_initial_window": 100,
              "arc_expansion_step": 100,
              "arc_local_composite_max_samples": 250000
