{
  "schema": "comotion.parameter_sweep.v1",
  "description": "Panda cage ARC and CompositeRRT parameter sweep with 8 seeds per setting and 100 second timeout.",
  "defaults": {
    "collision_backend": "vamp",
    "resolution": 128,
    "trials_per_param_set": 8,
    "methods": [
      "arc",
      "composite"
    ],
    "base_params": {
      "strrt_initial_batch_size": 4096,
      "strrt_initial_time_factor": 4.0,
      "strrt_time_bound_factor_increase": 2.0,
      "strrt_return_first_solution": true,
      "strrt_rewiring": "off",
      "drrt_roadmap_size": 300,
      "drrt_iterations_per_batch": 32,
      "drrt_cost_metric": "makespan",
      "drrt_tensor_search": "drrt",
      "arc_initial_window": 200,
      "arc_expansion_step": 200,
      "arc_local_composite_max_samples": 1000000,
      "arc_local_composite_use_makespan_metric": false,
      "arc_simplify_initial_solutions": true,
      "arc_simplify_conflict_solutions": false,
      "arc_local_solvers": "composite",
      "arc_local_prioritized_max_iterations": 10,
      "parallel_arc_conflict_find_horizon": 200,
      "stcbs_max_samples": 75000
    }
  },
  "apps": {
    "panda_cage_n4_100s": {
      "title": "Panda cage, 4 robots, ARC and CompositeRRT, 100s",
      "executable": "panda_cage",
      "args": [
        "--num-robots",
        "4",
        "--task-index",
        "0"
      ],
      "time_limit": 100.0,
      "param_grid": {
        "arc": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "smaller_windows",
            "params": {
              "arc_initial_window": 100,
              "arc_expansion_step": 100,
              "arc_local_composite_max_samples": 500000
            }
          },
          {
            "name": "tiny_windows",
            "params": {
              "arc_initial_window": 50,
              "arc_expansion_step": 50,
              "arc_local_composite_max_samples": 250000
            }
          },
          {
            "name": "larger_windows",
            "params": {
              "arc_initial_window": 400,
              "arc_expansion_step": 400
            }
          },
          {
            "name": "more_local_samples",
            "params": {
              "arc_local_composite_max_samples": 2000000
            }
          },
          {
            "name": "both_local_solvers",
            "params": {
              "arc_local_solvers": "both"
            }
          },
          {
            "name": "makespan_local_metric",
            "params": {
              "arc_local_composite_use_makespan_metric": true
            }
          },
          {
            "name": "simplify_conflicts",
            "params": {
              "arc_simplify_conflict_solutions": true
            }
          }
        ],
        "composite": [
          {
            "name": "default",
            "params": {}
          },
          {
            "name": "makespan_metric",
            "params": {
              "composite_rrt_use_makespan_metric": true
            }
          }
        ]
      }
    },
    "panda_cage_n8_100s": {
