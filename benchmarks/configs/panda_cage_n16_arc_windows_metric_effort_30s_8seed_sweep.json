{
  "schema": "comotion.parameter_sweep.v1",
  "description": "Panda cage n=16 ARC sweep crossing window size, local composite makespan metric, and local composite sample effort. Uses 8 seeds per setting and 30 second timeout.",
  "defaults": {
    "collision_backend": "vamp",
    "resolution": 128,
    "trials_per_param_set": 8,
    "methods": [
      "arc"
    ],
    "base_params": {
      "strrt_initial_batch_size": 4096,
      "strrt_initial_time_factor": 4.0,
      "strrt_time_bound_factor_increase": 2.0,
      "strrt_return_first_solution": true,
      "strrt_rewiring": "off",
      "drrt_roadmap_size": 300,
      "drrt_iterations_per_batch": 32,
      "drrt_cost_metric": "makespan",
      "drrt_tensor_search": "drrt",
      "arc_initial_window": 200,
      "arc_expansion_step": 200,
      "arc_local_composite_max_samples": 1000000,
      "arc_local_composite_use_makespan_metric": false,
      "arc_simplify_initial_solutions": true,
      "arc_simplify_conflict_solutions": false,
      "arc_local_solvers": "composite",
      "arc_local_prioritized_max_iterations": 10,
      "parallel_arc_conflict_find_horizon": 200,
      "stcbs_max_samples": 75000
    }
  },
