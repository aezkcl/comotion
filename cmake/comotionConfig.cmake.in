@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 REQUIRED)
find_dependency(Boost CONFIG REQUIRED COMPONENTS serialization program_options)
find_dependency(nlohmann_json 3.11.3 REQUIRED)
find_dependency(PkgConfig REQUIRED)
pkg_check_modules(FCL REQUIRED fcl)
find_dependency(ompl REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/comotionTargets.cmake")

if(TARGET comotion::comotion)
  target_include_directories(comotion::comotion INTERFACE ${FCL_INCLUDE_DIRS})
  target_link_directories(comotion::comotion INTERFACE ${FCL_LIBRARY_DIRS})
  target_link_libraries(comotion::comotion INTERFACE ${FCL_LIBRARIES})
endif()

check_required_components(comotion)
